{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "customConditions": ["source"],
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "resolveJsonModule": true
  }
}
