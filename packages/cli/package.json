{
  "name": "@core/cli",
  "version": "0.1.0",
  "license": "MIT",
  "description": "The core command: sign in to providers, then ask or chat from any terminal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cognitive-Interface-Lab/core.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Cognitive-Interface-Lab/core#readme",
  "bugs": "https://github.com/Cognitive-Interface-Lab/core/issues",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "type": "module",
  "bin": {
    "core": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "node ../../scripts/copy-license.mjs",
    "build": "tsdown src/main.ts --format esm --clean --no-fixed-extension",
    "start": "node --conditions=@core/source --import tsx src/main.ts",
    "typecheck": "node ../../node_modules/typescript-7/bin/tsc --noEmit -p ."
  },
  "dependencies": {
    "@core/contracts": "workspace:*",
    "@core/credentials": "workspace:*",
    "@core/graph-sqlite": "workspace:*",
    "@core/models": "workspace:*",
    "@core/runtime": "workspace:*",
    "@core/server": "workspace:*",
    "@core/tools": "workspace:*",
    "zod": "^4.0.0"
  }
}
