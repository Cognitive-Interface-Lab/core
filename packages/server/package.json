{
  "name": "@core/server",
  "version": "0.1.0",
  "license": "MIT",
  "description": "core's HTTP API with OpenAPI, and the local bridge behind core serve; mounts in another app's server too",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cognitive-Interface-Lab/core.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/Cognitive-Interface-Lab/core#readme",
  "bugs": "https://github.com/Cognitive-Interface-Lab/core/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@core/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "@core/source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "node ../../scripts/copy-license.mjs",
    "build": "tsdown src/index.ts src/node.ts --format esm --dts --clean --no-fixed-extension",
    "typecheck": "node ../../node_modules/typescript-7/bin/tsc --noEmit -p ."
  },
  "dependencies": {
    "@core/contracts": "workspace:*",
    "@core/graph": "workspace:*",
    "@core/models": "workspace:*",
    "@core/runtime": "workspace:*",
    "@core/tools": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12"
  }
}
